# Only needed for trading calls; reads work keyless at 0.5 req/s.
JUP_API_KEY=

# RPC used to land transactions Jupiter returns without an execution context (claims).
# Defaults to the public mainnet endpoint, which rate-limits under load.
SOLANA_RPC_URL=

# Signing is gated on purpose: this deposits real USDC on mainnet.
NEXT_PUBLIC_ALLOW_TRADING=false
